{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Configuration/Settings.xcconfig" },
    { "name": "Release", "file": "Configuration/Settings.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-log.git",
      "version": {
        "up-to-next-major-version": "1.16.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/getsentry/sentry-apple-swift-log.git",
      "version": {
        "up-to-next-major-version": "9.31.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/Alamofire/Alamofire",
      "version": {
        "up-to-next-major-version": "5.12.2",
      },
    },
  ],
  "files": [
    { "path": ".editorconfig" },
    { "path": ".swift-format" },
    { "path": "Makefile" },
    {
      "kind": "group",
      "path": "Configuration",
      "children": [
        { "path": "Settings.xcconfig" },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "SnapperWidget/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "SnapperWidget/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Snapper.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SnapperWidget.appex", "id": "DC99126F3071E25300DF8C76", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Snapper/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/SnapperTests.xctest", "id": "DCD4E1F63074CC7B0020A7D8", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/SnapperUITests.xctest", "id": "DCD4E2033074CCB60020A7D8", "type": "wrapper.cfbundle", "index": false },
      ],
    }, {
      "kind": "folder",
      "path": "Snapper",
      "target-membership": [
        "Snapper",
      ],
      "membership-exceptions": [
        {
          "target": "Snapper",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "SnapperWidget",
          "inclusions": [
            "App/Constants.swift",
            "Models/Album.swift",
            "Models/Track.swift",
            "Resources/Fonts/basteleur/Basteleur-Bold.ttf",
            "Resources/Fonts/basteleur/Basteleur-Moonlight.ttf",
            "Resources/Fonts/libre-caslon-text/LibreCaslonText-Bold.ttf",
            "Resources/Fonts/libre-caslon-text/LibreCaslonText-Italic.ttf",
            "Resources/Fonts/libre-caslon-text/LibreCaslonText-Regular.ttf",
            "Resources/Fonts/sligoil/Sligoil-Micro.ttf",
            "Resources/Fonts/sligoil/Sligoil-MicroBold.ttf",
            "Resources/Fonts/sligoil/Sligoil-MicroMedium.ttf",
            "Resources/Fonts/vg5000/VG5000-Regular.otf",
            "Services/Api/Dto/AlbumDto.swift",
            "Services/Api/Dto/TrackDto.swift",
            "Storage/JsonFile.swift",
            "Storage/SnapperSchema.swift",
            "Storage/SnapperStore.swift",
            "UI/Theme/Fonts.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "SnapperTests", "target-membership": [ "SnapperTests" ] },
    { "kind": "folder", "path": "SnapperUITests", "target-membership": [ "SnapperUITests" ] },
    {
      "kind": "folder",
      "path": "SnapperWidget",
      "target-membership": [
        "SnapperWidget",
      ],
      "membership-exceptions": [
        {
          "target": "SnapperWidget",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
  ],
  "targets": [
    {
      "name": "Snapper",
      "id": "000000000000000100000000",
      "product": "Products/Snapper.app",
      "product-type": "application",
      "dependencies": [
        "SnapperWidget",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "Alamofire",
          "product-name": "Alamofire",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "sentry-apple-swift-log",
          "product-name": "SentrySwiftLog",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-log",
          "product-name": "Logging",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Snapper/Snapper.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Snapper/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "MusicSnap",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.music",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.5",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "net.dmoncada.Snapper",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    }, {
      "name": "SnapperTests",
      "id": "DCD4E1F53074CC7B0020A7D8",
      "product": "Products/SnapperTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Snapper",
      "dependencies": [
        "Snapper",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.5",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "net.dmoncada.SnapperTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Snapper.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Snapper",
        "VALIDATE_PRODUCT[config=Release]": "YES",
      },
    }, {
      "name": "SnapperUITests",
      "id": "DCD4E2023074CCB60020A7D8",
      "product": "Products/SnapperUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "Snapper",
      "dependencies": [
        "Snapper",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.5",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "net.dmoncada.SnapperUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1",
        "TEST_TARGET_NAME": "Snapper",
        "VALIDATE_PRODUCT[config=Release]": "YES",
      },
    }, {
      "name": "SnapperWidget",
      "id": "DC99126E3071E25300DF8C76",
      "product": "Products/SnapperWidget.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_WIDGET_BACKGROUND_COLOR_NAME": "WidgetBackground",
        "CODE_SIGN_ENTITLEMENTS": "SnapperWidget/SnapperWidget.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "SnapperWidget/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "MusicSnapWidget",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.5",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
