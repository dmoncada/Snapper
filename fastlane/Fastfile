require "json"

default_platform(:ios)

platform :ios do
  desc "Capture Search, History, and Detail with the newest ten fixture albums"
  lane :screenshots do |options|
    root = File.expand_path("..", __dir__)
    output = File.expand_path(options[:output] || "fastlane/screenshots", root)

    albums = JSON.parse(
      File.read(
        File.join(
          root,
          "PreviewContent/albums.json"
        )
      )
    ).fetch("albums")

    latest = albums.sort_by { |album| album.fetch("selectedAt") }.last(10)

    missing = latest.filter_map do |album|
      artwork = File.join(
        root,
        "PreviewContent/Assets.xcassets/Covers",
        "Album-#{album.fetch('discogsId')}.imageset/cover.jpg"
      )
      album.fetch("discogsId") unless File.file?(artwork)
    end

    UI.user_error!("Missing bundled artwork for Discogs IDs: #{missing.join(', ')}") unless missing.empty?

    capture_screenshots(
      project: "Snapper.xcodeproj",
      scheme: "Snapper",
      configuration: "Debug",
      only_testing: ["SnapperUITests/ScreenshotUITests"],
      devices: [options[:device] || "iPhone 18 Pro"],
      languages: [options[:locale] || "en-US"],
      output_directory: output,
      derived_data_path: File.join(root, ".build/snapshot-derived"),
      clear_previous_screenshots: true,
      override_status_bar: true,
      dark_mode: options[:dark] == true,
      concurrent_simulators: false,
      skip_open_summary: true,
      stop_after_first_error: true
    )

    frame_screenshots(path: output) if options[:frame] == true
  end
end
